# Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=NovaChat AI

# Payment provider: payos (phù hợp VietQR tại Việt Nam) hoặc stripe
PAYMENT_PROVIDER=payos

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# OpenAI - server only
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.6-terra
CHATBOT_SYSTEM_PROMPT=Bạn là trợ lý AI chuyên nghiệp. Trả lời chính xác, rõ ràng và hữu ích bằng tiếng Việt.
# Optional: vector store containing your chatbot knowledge files
OPENAI_VECTOR_STORE_ID=

# payOS - server only (dùng khi PAYMENT_PROVIDER=payos)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Stripe - server only (dùng khi PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...
